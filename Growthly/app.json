{
  "expo": {
    "name": "Growthly",
    "slug": "Growthly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/growthly-logo-color@3x.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/logo/growthly-logo-color@3x.png",
        "resizeMode": "contain",
        "backgroundColor": "#203452"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/growthly-icon.png",
        "backgroundColor": "#203452"
      },
      "splash": {
        "image": "./assets/images/logo/growthly-logo-color@3x.png",
        "resizeMode": "contain",
        "backgroundColor": "#203452"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo/growthly-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/growthly-logo-color@3x.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#203452"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
